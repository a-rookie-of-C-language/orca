{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orca Tauri PoC",
  "version": "0.1.0",
  "identifier": "com.stablyai.orca.tauri-poc",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. exec vite --config vite.web.config.ts --host 127.0.0.1 --port 5174",
    "devUrl": "http://127.0.0.1:5174/web-index.html",
    "beforeBuildCommand": "pnpm --dir ../.. build:web && node ../scripts/prepare-web-dist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orca Tauri PoC",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
