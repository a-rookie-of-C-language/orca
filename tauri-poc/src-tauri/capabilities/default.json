{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Native capabilities used by the Orca Tauri feasibility shell.",
  "windows": ["main", "workspace-space"],
  "remote": {
    "urls": ["http://127.0.0.1:5174", "http://localhost:5174"]
  },
  "permissions": [
    "core:default",
    "core:image:default",
    "core:resources:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-image",
    "allow-poc-host-info",
    "allow-poc-path-exists",
    "allow-poc-paths-exist",
    "allow-poc-copy-file",
    "allow-poc-open-external-editor",
    "allow-poc-read-file-data-url",
    "allow-poc-platform-info",
    "allow-poc-app-identity",
    "allow-poc-is-maximized",
    "allow-poc-is-minimized",
    "allow-poc-minimize",
    "allow-poc-toggle-maximize",
    "allow-poc-set-zoom",
    "allow-poc-get-zoom",
    "allow-poc-set-focus",
    "allow-poc-reveal-window",
    "allow-poc-relaunch",
    "allow-poc-main-force-reload",
    "allow-poc-consume-second-instance-events",
    "allow-poc-consume-pending-open-settings",
    "allow-poc-resolve-opened-documents",
    "allow-poc-request-close",
    "allow-poc-confirm-close",
    "allow-poc-popup-menu",
    "allow-poc-validate-dropped-paths",
    "allow-poc-window-get-bounds",
    "allow-poc-window-set-bounds",
    "allow-poc-menu-set-appearance-checks",
    "allow-poc-menu-set-hints",
    "allow-poc-clipboard-read-file-paths",
    "allow-poc-clipboard-write-file",
    "allow-poc-clipboard-restore-native-chat-pastes",
    "allow-poc-stage-external-paths",
    "allow-poc-read-external-file-chunk",
    "allow-poc-save-downloaded-file",
    "allow-poc-start-downloaded-file",
    "allow-poc-append-downloaded-file-chunk",
    "allow-poc-finish-downloaded-file",
    "allow-poc-cancel-downloaded-file",
    "allow-poc-start-downloaded-folder",
    "allow-poc-finish-downloaded-folder",
    "allow-poc-cancel-downloaded-folder",
    "allow-poc-import-external-paths",
    "allow-poc-runtime-pairing",
    "allow-poc-runtime-status",
    "allow-poc-browser-create",
    "allow-poc-browser-close",
    "allow-poc-browser-cancel-download",
    "allow-poc-browser-download-blob",
    "allow-poc-browser-open-devtools",
    "allow-poc-browser-set-bounds",
    "allow-poc-browser-set-visible",
    "allow-poc-browser-navigate",
    "allow-poc-browser-go-back",
    "allow-poc-browser-go-forward",
    "allow-poc-browser-reload",
    "allow-poc-browser-stop",
    "allow-poc-browser-focus",
    "allow-poc-browser-guest-edit",
    "allow-poc-browser-proceed-certificate",
    "allow-poc-browser-set-zoom",
    "allow-poc-browser-set-viewport-override",
    "allow-poc-browser-set-annotation-viewport-bridge",
    "allow-poc-browser-set-grab-mode",
    "allow-poc-browser-await-grab-selection",
    "allow-poc-browser-cancel-grab",
    "allow-poc-browser-extract-hover-payload",
    "allow-poc-browser-capture-selection-screenshot",
    "allow-poc-browser-cdp",
    "allow-poc-browser-cdp-session",
    "allow-poc-browser-cdp-subscribe",
    "allow-poc-browser-cdp-unsubscribe",
    "allow-poc-browser-get-handled-shortcuts",
    "allow-poc-browser-set-handled-shortcuts",
    "allow-poc-browser-identity-get",
    "allow-poc-browser-identity-set",
    "allow-poc-browser-identity-set-renderer-user-agent",
    "allow-poc-shell-availability",
    "allow-poc-list-system-fonts",
    "allow-poc-list-directory"
  ]
}
